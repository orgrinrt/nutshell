#!/usr/bin/env bash
# =============================================================================
# nutshell - Interpreter for #!/usr/bin/env nutshell scripts
# =============================================================================
# Part of nutshell - Everything you need, in a nutshell.
# https://github.com/orgrinrt/nutshell
#
# A script starting with
#
#   #!/usr/bin/env nutshell
#
# is run by this, which sets the environment up and sources it, so `use` is
# available from its first line and the script needs no bootstrap of its own.
#
# Also a small CLI:
#
#   nutshell <script>       run a script with the nutshell environment
#   nutshell --version      print the version
#   nutshell --help         what is here
#
# The environment itself comes from `init`, sourced below rather than repeated.
# This file used to carry its own copy of `use`, `nut_once` and the loaded-module
# table, and the two had already drifted: the copy here had lost the module
# error tracking, so which one you got depended on whether a script was run
# through the shebang or sourced `init` directly.
# =============================================================================

set -uo pipefail

# The shebang line names whatever is on PATH, which is normally a symlink into
# a checkout. Follow it to the real file, because the library sits next to it.
_resolve_path() {
    local path="$1" dir
    while [[ -L "$path" ]]; do
        dir="$(cd "$(dirname "$path")" && pwd)"
        path="$(readlink "$path")"
        [[ "$path" != /* ]] && path="$dir/$path"
    done
    printf '%s' "$path"
}

_SELF="$(_resolve_path "${BASH_SOURCE[0]}")"
_NUTSHELL_BIN_DIR="$(cd "$(dirname "$_SELF")" && pwd)"
_NUTSHELL_HOME="$(cd "${_NUTSHELL_BIN_DIR}/.." && pwd)"

# shellcheck source=/dev/null
source "${_NUTSHELL_HOME}/init" || {
    echo "nutshell: cannot load ${_NUTSHELL_HOME}/init" >&2
    exit 1
}

_show_help() {
    cat <<EOF
nutshell - Everything you need, in a nutshell.

Usage:
  nutshell <script>       Run a script with nutshell environment
  nutshell --version      Show version
  nutshell --help         Show this help

As a shebang:
  #!/usr/bin/env nutshell
  use os log
  log_info "Hello!"

Available modules:
  $(nutshell_available | tr '\n' ' ')

For more information: https://github.com/orgrinrt/nutshell
EOF
}

case "${1:-}" in
    --help|-h)
        _show_help
        exit 0
        ;;
    --version|-v)
        echo "nutshell ${NUTSHELL_VERSION}"
        exit 0
        ;;
    "")
        _show_help
        exit 1
        ;;
    *)
        _SCRIPT="$1"
        shift

        if [[ ! -f "$_SCRIPT" ]]; then
            echo "nutshell: script not found: $_SCRIPT" >&2
            exit 1
        fi

        # Sourced, not executed, so the script runs in this environment with
        # `use` already defined.
        # shellcheck source=/dev/null
        source "$_SCRIPT"
        ;;
esac
