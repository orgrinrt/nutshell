#!/usr/bin/env bash
# =============================================================================
# nutshell/bin/nut-gen-resolver - The module map, as shell rather than as data
# =============================================================================
# Part of nutshell - Everything you need, in a nutshell.
# https://github.com/orgrinrt/nutshell
#
# Reads `lib.nut` and writes the same information as a `case`.
#
# The manifest is the source and stays the source. What this removes is the
# parsing: `_lib_nut_lookup` walks every row of `lib.nut` on every lookup,
# splitting fields and accumulating gate lines, to answer a question whose
# answer changes only when somebody edits the manifest. A `case` answers it
# without reading anything.
#
# The output is POSIX. That is the point beyond the parsing: `init` opens with
# `declare -gA`, so the library's own entry point is the one file a POSIX shell
# cannot read, and every floor number so far has been about lowered artifacts
# with that door still shut.
#
# Gates stay live here, and that is not a contradiction of resolving them at
# lower time. A lowering builds for a target and settles them; this is the
# entry point somebody sources while developing, where the machine running it
# is the machine being asked about.
#
# NOT WIRED YET, deliberately. `use` still calls `_lib_nut_lookup`, so this is
# generated, diff-checked against the manifest and tested, and nothing loads
# it. It is staged for the `init` dissolution, where the resolver stops being a
# thing `init` computes and becomes a thing `lib.nut` produces. Saying so here
# because 145 generated lines that nobody sources read as a live resolver.
#
# Usage:
#   nut-gen-resolver [root] > resolver
# =============================================================================

set -uo pipefail

ROOT="${1:-$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)}"
NUT="${ROOT}/lib.nut"

[ -r "$NUT" ] || { printf 'nut-gen-resolver: no lib.nut at %s\n' "$ROOT" >&2; exit 1; }

printf '# Generated by nut-gen-resolver from lib.nut. Do not edit.\n'
printf '#\n'
printf '# The manifest is the source. This is the same rows as a `case`, so a\n'
printf '# lookup answers without reading a file. Regenerate when lib.nut moves;\n'
printf '# `check_resolver_current` fails when this and the manifest disagree.\n\n'
printf '_nut_resolve() {\n'
printf '    _nr_root="${2:-$NUTSHELL_ROOT}"\n'
printf '    _nr_reach="${3:-any}"\n'
printf '    case "$1" in\n'

# Rows grouped by module name, in manifest order, each carrying the gates that
# were accumulated above it and its visibility.
current=""
gates=""
{
while read -r name file rest || [ -n "$name" ]; do
    case "$name" in
        '') continue ;;
        '#['*) w="${name#\#\[}"; w="${w%]}"; gates="${gates}${w} "; continue ;;
        '#'*) gates=""; continue ;;
    esac
    [ -n "$file" ] || continue

    vis=""
    for w in $rest; do
        case "$w" in
            when=*) printf 'nut-gen-resolver: %s still uses `%s` on `%s`\n' \
                        "$NUT" "$w" "$name" >&2; exit 1 ;;
            '#'*) break ;;
            *) vis="$w" ;;
        esac
    done

    if [ "$name" != "$current" ]; then
        [ -n "$current" ] && printf '            ;;\n'
        printf '        %s)\n' "$name"
        current="$name"
    fi

    # One branch per row, in manifest order, so the first whose gates hold
    # wins exactly as the walk did.
    printf '            '
    for g in $gates; do
        printf '_nut_gate %s && ' "'$g'"
    done
    if [ "$vis" = "internal" ]; then
        printf '{ [ "$_nr_reach" = public ] && { echo "nutshell: '"'"'%s'"'"' is internal to that library" >&2; return 1; }; printf %s "$_nr_root/%s"; return 0; }\n' \
            "$name" "'%s'" "$file"
    else
        printf '{ printf %s "$_nr_root/%s"; return 0; }\n' "'%s'" "$file"
    fi
    gates=""
done < "$NUT"
[ -n "$current" ] && printf '            ;;\n'
}
printf '    esac\n'
printf '    return 1\n'
printf '}\n'
