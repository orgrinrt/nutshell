#!/usr/bin/env bash
# =============================================================================
# nutshell/init - Main entry point
# =============================================================================
# Source this file to use nutshell in your scripts.
#
# Usage:
#   #!/usr/bin/env bash
#   . "${0%/*}/lib/nutshell/init"
#
#   use os log json
#   log_info "Hello from nutshell!"
#
# =============================================================================

# =============================================================================
# The floor, before anything that needs it
# =============================================================================
#
# Everything below this point needs bash 4: associative arrays, `declare -g`,
# `[[ =~ ]]` with `BASH_REMATCH`. macOS ships 3.2 at `/bin/bash` and that is
# the machine this is most often reached from, so the refusal has to be here
# and it has to be loud.
#
# It used to be neither. `declare -A` failed twice, `_NUTSHELL_LOADED` was not
# an associative array, the first `use` died on an unbound variable, and the
# interpreter **exited 0**. A Makefile, a task runner or CI read that as
# success. Measured on bash 3.2.57: three errors and `EXIT=0`.
#
# Written so any shell can read it. `${BASH_VERSINFO...}` is a bash-only
# expansion, so it is spelled through `case` on `$BASH_VERSION`, which is a
# plain string, and the whole block parses under `sh` and under bash 3.
_nutshell_refuse_old_bash() {
    printf 'nutshell needs bash 4.0 or newer.\n' >&2
    printf '  this is: %s\n' "${BASH_VERSION:-not bash at all}" >&2
    printf '  macOS ships 3.2 at /bin/bash. Install a current one and put it\n' >&2
    printf '  first on PATH, or run this under it directly.\n' >&2
}

# `return` here returns to whoever sourced this and cannot stop them, so the
# caller has to check. Every example in the readme ends its source line in
# `|| exit 1` for that reason, and both consumers do the same.
case "${BASH_VERSION:-}" in
    ""|1.*|2.*|3.*)
        _nutshell_refuse_old_bash
        return 1 2>/dev/null || exit 1 ;;
esac
# Prevent multiple inclusion
[[ -n "${_NUTSHELL_INIT:-}" ]] && return 0
_NUTSHELL_INIT=1

# =============================================================================
# Resolve paths
# =============================================================================

# The directory a file sits in, absolute, into `_ncd`; empty when it cannot be
# entered. What `cd "$(dirname f)" && pwd` answers, without the fork, for the
# case every module load is: an absolute directory with no `.` or `..` in it,
# which that pair hands back unchanged. A name with no slash sits in the
# working directory and a name directly under `/` sits in `/`, as `dirname`
# has them.
_nut_caller_dir() {
    case "$1" in
        */*) ;;
        *) _ncd="$PWD"; return 0 ;;
    esac
    _ncd="${1%/*}"
    case "$_ncd" in
        "") _ncd="/"; return 0 ;;
        /*/./*|/*/../*|*/.|*/..|*//*|/./*|/../*) ;;
        /*) [[ -d "$_ncd" ]] || _ncd=""; return 0 ;;
    esac
    _ncd="$(cd "${1%/*}" 2>/dev/null && pwd)" || _ncd=""
}

# Find our own directory (absolute path)
_nut_caller_dir "${BASH_SOURCE[0]}"
_NUTSHELL_ROOT="$_ncd"

# Export for use by modules
export NUTSHELL_ROOT="${_NUTSHELL_ROOT}"
# Read from the manifest rather than written here.
#
# It was a constant somebody had to remember to bump, and forgetting it is
# silent: `init` said 0.6.0 while the newest tag was 0.6.1, because that
# release was documentation and its bump got reverted before merging. A
# release with nothing else to change is exactly when it is forgotten.
#
# Read as text, not through the toml module, because this runs before any
# module is loaded and the parser is itself a module. One key, one shape.
# _nutshell_read_version -> `_NUT_VER`, the version `[package]` names
_nutshell_read_version() {
    local f="${_NUTSHELL_ROOT}/nut.toml" line in_pkg=0
    [ -r "$f" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            \[package\]*) in_pkg=1; continue ;;
            \[*\]*)       in_pkg=0; continue ;;
        esac
        [ "$in_pkg" -eq 1 ] || continue
        case "$line" in
            version*=*)
                line="${line#*=}"
                line="${line#"${line%%[![:space:]]*}"}"
                line="${line#[\"\']}"
                line="${line%%[!0-9.]*}"
                [ -n "$line" ] || continue
                _NUT_VER="$line"; return 0 ;;
        esac
    done < "$f"
    return 1
}
# Into a variable rather than captured, since a capture is a fork before a
# script has run a line.
_NUT_VER=""
_nutshell_read_version 2>/dev/null
export NUTSHELL_VERSION="$_NUT_VER"

# Script identity belongs to the interpreter invocation, not to ancestry. The
# interpreter exports NUTSHELL_SCRIPT and NUTSHELL_SCRIPT_DIR after this file
# runs, so its own script keeps them; a process that sources init directly
# would otherwise inherit an ancestor's values and resolve that ancestor's
# nut.toml as if it were its own.
unset NUTSHELL_SCRIPT NUTSHELL_SCRIPT_DIR

# Add our bin to PATH so the shebang #!/usr/bin/env nutshell works
# for any scripts called after this init
export PATH="${_NUTSHELL_ROOT}/bin:$PATH"

# =============================================================================
# The key encoder, before anything that keys on a string
# =============================================================================
#
# Sourced by path rather than declared, because `use` is defined below it and
# a module cannot be asked for by the thing that has not defined asking yet.
# The path is fixed and the file guards itself, so a later `use key` is a
# no-op rather than a second load.
# shellcheck source=/dev/null
. "${_NUTSHELL_ROOT}/lib/key.sh" || {
    printf 'nutshell: cannot load %s/lib/key.sh\n' "$_NUTSHELL_ROOT" >&2
    return 1 2>/dev/null || exit 1
}

# =============================================================================
# Module tracking
# =============================================================================

# What has been loaded, keyed by the file rather than by the words that asked
# for it. One module is reachable by several names: its own unit calls it
# `super::tui::key`, a consumer calls it `shebang::tui::key`, and both are the
# same file. Keyed by the spelling, each of those loaded it again, and a module
# without a guard of its own ran twice.
# One table, an associative array keyed by the table's name and the key, plus a
# list of each table's keys, a line apart.
#
# The list is there because two readers walk what is loaded: `nutshell_modules`
# reports it and `nut_reload` has to find every name that reached one file. It
# was one variable per entry keyed by `nut_key`, which hexes the key a byte at a
# time: `use` keyed every file it loaded by a path of sixty bytes or more, three
# times, and that was most of what a `use` cost. A removed entry keeps its line
# and has an empty value, which every reader takes as absent.
declare -p _NUT_LT >/dev/null 2>&1 || declare -gA _NUT_LT=()
_NUT_LOADED_KEYS="${_NUT_LOADED_KEYS:-}"
# The names that reached each file, so `nutshell_loaded <name>` still answers.
_NUT_LOADED_AS_KEYS="${_NUT_LOADED_AS_KEYS:-}"

# _nut_loaded_set <table> <key> <value>, and the key goes in the list once.
_nut_loaded_set() {
    [[ -n "${2:-}" ]] || return 1
    if [[ -z "${_NUT_LT[$1$'\x1f'$2]+x}" ]]; then
        case "$1" in
            LOADED)    _NUT_LOADED_KEYS+="$2"$'\n' ;;
            LOADED_AS) _NUT_LOADED_AS_KEYS+="$2"$'\n' ;;
        esac
    fi
    _NUT_LT[$1$'\x1f'$2]="$3"
}

# _nut_loaded_get <table> <key>, into `_nl`
_nut_loaded_get() {
    _nl=""
    [[ -n "${2:-}" ]] || return 1
    _nl="${_NUT_LT[$1$'\x1f'$2]-}"
    [[ -n "$_nl" ]]
}

# _nut_loaded_unset <table> <key>
_nut_loaded_unset() {
    [[ -n "${2:-}" ]] || return 1
    [[ -z "${_NUT_LT[$1$'\x1f'$2]+x}" ]] || _NUT_LT[$1$'\x1f'$2]=""
}

# nut_once
#
# The include guard, deriving its own key from the file that calls it, so a
# module says `nut_once || return 0` instead of inventing a unique variable
# name and typing it twice. The name was always computable from the path; the
# only reason it was written by hand is that nothing offered to compute it.
#
# Returns 0 the first time a given file calls it, non-zero after, so the idiom
# reads as "carry on, or stop".
nut_once() {
    local src="${BASH_SOURCE[1]:-${BASH_SOURCE[0]}}"
    # Canonical, and the same canonical `use` keys on. Keyed on the raw string
    # instead, a file loaded through the resolver and then sourced again by a
    # relative path was two different keys, so the second load ran: for a
    # module whose functions are lazy stubs, that reinstalls the stubs over the
    # bindings an implementation had already made, and the stub then calls
    # itself until the stack dies.
    _nut_realpath_to "$src" 2>/dev/null && src="$_nr"
    local key="_NUT_ONCE_${src//[^A-Za-z0-9]/_}"
    [[ -n "${!key:-}" ]] && return 1
    printf -v "$key" '%s' 1
    # What `use` knows and what this knows are the same fact, so record it
    # where `use` looks as well.
    _nut_loaded_set LOADED "$src" 1
    return 0
}

# =============================================================================
# Module loading (for script authors)
# =============================================================================

# use <module...>
#
# Load one or more modules. The same line in a script and at the top of a
# module: a script says what it wants, a module says what it cannot work
# without, and both are the same act, so there is nothing to keep in step.
#
# The distinction is not worth a second function. A wrapper that only forwards
# to this one would be one more name to learn and one more place for the two
# to drift, and the module-contract check reads `use` lines either way.
#
# Declaring is what makes the dependency checkable. `toml.sh` called `str_trim`
# for its whole life while declaring nothing, so `toml_get` worked or silently
# returned nothing depending on whether something else had loaded `string`
# first. Nothing reported it, because from inside bash a function that is
# present is present. That is as close to sourcing without leaks as one global
# function table permits, and it is honest about being a check rather than an
# isolation boundary.
#
# Usage: use os log json http
use() {
    local mod
    for mod in "$@"; do
        # A name already known to point at a loaded file, answered without
        # touching the filesystem.
        #
        # Not for `super::`, which is relative to whoever wrote it: two units
        # each with their own lib/guard.sh both say `super::guard` and mean
        # different files. Cached globally, the second unit's `use` matched the
        # first unit's entry, loaded nothing, and returned 0 -- the module
        # simply was not there, and nothing said so.
        if [[ "$mod" != super::* ]]; then
            _nut_loaded_get LOADED_AS "$mod" && continue
        fi
        
        # Where it is. One resolver, so `use` and `nut_reload` cannot come to
        # different conclusions about what a name means.
        #
        # BASH_SOURCE[1] is the file that wrote the `use`, which is the unit a
        # `super::` belongs to. BASH_SOURCE[0] is init itself and
        # NUTSHELL_SCRIPT_DIR is the entry point; neither answers "which unit
        # is asking".
        local mod_path
        _use_resolve_to "$mod" "${BASH_SOURCE[1]:-}" || return 1
        mod_path="$_NUT_RES"

        if [[ -f "$mod_path" ]]; then
            # The file decides identity, so a module reached by two names is
            # loaded once. Canonical, because a relative path and an absolute
            # one naming the same file are the same module.
            local _real
            if _nut_realpath_to "$mod_path"; then _real="$_nr"; else _real="$mod_path"; fi

            if _nut_loaded_get LOADED "$_real"; then
                # Recorded under a key that carries the unit, so one unit's
                # answer is never handed to another's question.
                if [[ "$mod" == super::* ]]; then
                    _nut_loaded_set LOADED_AS "${_real}::${mod}" "$_real"
                else
                    _nut_loaded_set LOADED_AS "$mod" "$_real"
                fi
                continue
            fi

            # Marked before sourcing, not after. A module that declares its own
            # dependencies can be part of a cycle, and marking afterwards means
            # neither module in one is ever recorded as loaded while it is being
            # loaded, so the pair recurses until the stack gives out. Marking
            # first makes the second entry a no-op, which is what "already
            # loading" should mean.
            _nut_loaded_set LOADED "$_real" 1
            if [[ "$mod" == super::* ]]; then
                _nut_loaded_set LOADED_AS "${_real}::${mod}" "$_real"
            else
                _nut_loaded_set LOADED_AS "$mod" "$_real"
            fi
            # Under `bin/nutshell`, a function the script wrote itself in
            # place of one of the interpreter's stubs is put back after the
            # module goes over it, as it stood on dev. `_nut_prelude_keep`
            # says which; local, as the module's own `use`s come through here.
            local _pk=""
            if [[ -n "${_NUT_PRELUDE_OWN:-}" ]]; then
                _nut_prelude_keep "$_real"
                _pk="$_NUT_PK"
            fi
            if ! source "$mod_path"; then
                # Failed to load, so it is not loaded. Leaving the mark would
                # make a later retry silently succeed against a module that was
                # never sourced.
                _nut_loaded_unset LOADED "$_real"
                _nut_loaded_unset LOADED_AS "$mod"
                _nut_loaded_unset LOADED_AS "${_real}::${mod}"
                return 1
            fi
            [[ -z "$_pk" ]] || eval "$_pk"
        else
            echo "nutshell: unknown module '$mod'" >&2
            echo "  Available: $(ls -1 "${_NUTSHELL_ROOT}/lib/"*.sh 2>/dev/null | xargs -n1 basename | sed 's/\.sh$//' | tr '\n' ' ')" >&2
            return 1
        fi
    done
}

# _lib_nut_lookup <root> <module-path>
#
# The file a library says a module lives in, from the `lib.nut` at its root.
#
# A library declares what it provides, in one place, instead of the resolver
# guessing among three layouts and taking whichever answered first. That guess
# is why a module could be found in the wrong place and why nothing could say,
# before running, that a name would not resolve. A declaration turns "no file
# answered" into "not in the tree", which is checkable without running
# anything.
#
# The format is one module per line, `<module-path> <file>`, because this is
# read before any module is loaded and the TOML parser is itself a module. A
# declaration file needing a parser you must load a module to obtain is a cycle
# at the very bottom of the stack.
#
#   # anything after a hash is a comment
#   log                 lib/log.sh
#   tui::term           libs/tui/term.sh
#   json::impl::jq      lib/json/impl/jq.sh      internal
#   #[has(bin(grep))]
#   text                lib/text.fast.sh
#   text                lib/text.sh
#
# `internal` means the library's own file, reachable by `super::` from inside
# and not by name from outside. Files picked at runtime by capability, like the
# json and fs implementations, are that: they are sourced directly by the
# module that chooses between them, and were never modules anybody names.
# The third argument, when given, is the visibility a caller is allowed to
# reach: `any` from inside the unit, `public` from outside it.
#
# A module may be declared more than once, and the first row whose gates hold
# is the one sourced. A gate is an attribute on the line above, the way
# `#[cfg(...)]` sits above a `mod` in Rust:
#
#   #[shell(bash4)]
#   text  lib/text.bash.sh
#   #[has(bin(grep))]
#   text  lib/text.grep.sh
#   text  lib/text.sh
#
# The row with no gates is the floor and always holds. It goes last, because
# the order in the file is the order they are tried, and a floor above a better
# row makes that row unreachable.
#
# `when=<predicate>` in the fourth column was the earlier form and is refused
# rather than ignored. It had already stopped being read: everything after the
# file became words with the last one taken as the visibility, so a row saying
# `when=shell:nosuchshell` set the visibility to that string, failed to match
# `internal`, and the module loaded on a machine whose predicate did not hold.
# Silently, which is how this kind of thing always goes and is the same failure
# the note further down describes being fixed once already.
#
# The decision is taken **before the file is sourced**, which is the whole
# point of putting it here rather than inside a module. A file using a
# construct the running shell cannot parse fails at parse time, so no
# `if` inside it can guard it: the guard has to sit above the sourcing, and
# `use` is where that is.
#
# This is the shell half. The half that picks between tools already exists and
# is not replaced: `text_grep` chooses `grep` over `perl` at first call and
# reloads. That is per function and inside a module; this is per module and
# above it, and a library will use both.
_lib_nut_lookup() {
    _lib_nut_lookup_to "$@" || return 1
    printf '%s' "$_NUT_LK"
}

# The same answer, into `_NUT_LK`, for a caller in this shell: `use` asks it for
# every module and the capture around the printing form was a fork each time.
_lib_nut_lookup_to() {
    _NUT_LK=""
    local root="$1" want="$2" reach="${3:-any}" file vis rest word gates row _nli
    _lib_nut_index "$root" || return 1
    # Every row declaring the name, in the order the file gives them, each with
    # the gates written above it. The first whose gates hold is the answer.
    #
    # Found by a regex rather than by `${s#*pat}`, which bash matches against
    # every prefix of the index in turn: 870us a lookup against 45us on
    # nutshell's own. A name with a character the regex would read as syntax,
    # which no module name has, takes the pattern.
    local s="$_nli" pat=$'\n'"${want}"$'\x1f' esc="$want" re=""
    case "$esc" in *[!A-Za-z0-9_:.-]*) esc="" ;; esac
    [[ -n "$esc" ]] && re=$'\n'"${esc//./[.]}"$'\x1f''([^'$'\n'']*)'
    while :; do
        if [[ -n "$re" ]]; then
            [[ "$s" =~ $re ]] || break
            row="${BASH_REMATCH[1]}"
        else
            [[ "$s" == *"$pat"* ]] || break
            s="${s#*"$pat"}"
            row="${s%%$'\n'*}"
        fi
        gates="${row%%$'\x1f'*}"; row="${row#*$'\x1f'}"
        file="${row%%$'\x1f'*}"; rest="${row#*$'\x1f'}"
        [[ -n "$file" ]] || return 1

        # Everything after the file is read as words rather than by position,
        # because a row may carry a visibility and a predicate both and
        # demanding an order of them is a rule nobody would remember.
        #
        # Taken by position first, and `internal when=...` then read the
        # visibility, ignored the fourth word entirely, and loaded the module
        # on a machine whose predicate did not hold. Silently, which is the
        # only way this kind of thing ever goes.
        # `_nut_words` at both splits below, since both read `lib.nut`. An
        # unquoted split hands authored text to the glob, so a `*` in a row
        # becomes whatever files sit beside the checkout, and the resolver
        # generated from this same manifest has the identical pair.
        vis=""
        local -a rwords gwords
        _nut_words "$rest"; rwords=(${_nw[@]+"${_nw[@]}"})
        # `${a[@]+"${a[@]}"}` and not `"${a[@]}"`, at every one of these. Before
        # bash 4.4, expanding an array with no assigned elements under `set -u`
        # throws `unbound variable` and kills the shell, and `bin/nutshell` sets
        # `-u` before it sources this. Most rows in a `lib.nut` carry no third
        # field, so `rest` is empty on nearly all of them and the first `use`
        # would die on bash 4.0 through 4.3, which is inside the 4.0 floor this
        # library declares.
        for word in ${rwords[@]+"${rwords[@]}"}; do
            # The retired form, refused loudly. Ignoring it is what made a
            # module load on a machine its predicate excluded.
            if [[ "$word" == when=* ]]; then
                printf 'nutshell: %s/lib.nut still uses `%s` on `%s`.\n' \
                    "$root" "$word" "$want" >&2
                printf '  Gates are an attribute on the line above the row now:\n' >&2
                printf '    #[shell(bash4)]\n    %s  %s\n' "$want" "$file" >&2
                return 1
            fi
            vis="$word"
        done

        local g held=0
        _nut_words "$gates"; gwords=(${_nw[@]+"${_nw[@]}"})
        for g in ${gwords[@]+"${gwords[@]}"}; do
            if ! _nut_gate "$g"; then held=1; break; fi
        done
        if [[ "$held" -eq 1 ]]; then
            # Past this row for the next try. Here and not at every match, since
            # capturing the rest of the index each time copied all of it.
            [[ -n "$re" ]] && s="${s#*"${pat}${gates}"$'\x1f'"${file}"$'\x1f'"${rest}"}"
            continue
        fi

        if [[ "$reach" == "public" && "${vis:-}" == "internal" ]]; then
            echo "nutshell: '${want}' is internal to that library" >&2
            return 1
        fi
        _NUT_LK="${root}/${file}"
        return 0
    done
    return 1
}

# _nut_words <text> -> `_nw`, its words, split on blanks without a here-string
# or the glob. The here-string `read -ra` took was a temporary file or a pipe per
# row looked up, about a millisecond each, and an unquoted split would hand
# authored text to the glob.
_nut_words() {
    _nw=()
    local s="$1" w
    while :; do
        s="${s#"${s%%[![:space:]]*}"}"
        [[ -n "$s" ]] || return 0
        w="${s%%[[:space:]]*}"
        _nw+=("$w")
        s="${s#"$w"}"
    done
}

# _lib_nut_index <root> -> `_nli`, the rows of a library's `lib.nut`, read once
#
# Each row on a line of its own as name, gates, file and the rest, split by the
# unit separator, so a lookup finds its name's rows without walking the others.
# `use` looks a name up for every module it loads, and walking the manifest row
# by row each time was the largest share of what a load cost once the forks
# around it were gone.
#
# Kept per library and checked against the file's text on every lookup, which
# is one read and no parse, so a manifest edited while a process runs is read
# again rather than answered from what it said before.
#
# The rows are read the way they always were. `|| [[ -n "$name" ]]`, so a file
# whose last line has no newline keeps its last declaration. An attribute is a
# comment, which is the whole reason for the shape: `#` already means comment
# here, so a reader that does not know about gates skips them and the file
# stays the format it was. They attach downward and accumulate, the way they do
# in a shell file and the way `#[cfg(...)]` does above a `mod` in Rust, and a
# run of them all has to hold for the row under it.
_NUT_LKI_ROOTS=""
_NUT_LKI_N=0
_lib_nut_index() {
    local root="$1" txt="" n tv iv
    [[ -r "${root}/lib.nut" ]] || return 1
    IFS= read -r -d '' txt < "${root}/lib.nut"
    if [[ "$_NUT_LKI_ROOTS" == *$'\n'"$root"$'\t'* ]]; then
        n="${_NUT_LKI_ROOTS#*$'\n'"$root"$'\t'}"; n="${n%%$'\n'*}"
    else
        n=$(( _NUT_LKI_N + 1 )); _NUT_LKI_N="$n"
        _NUT_LKI_ROOTS+=$'\n'"$root"$'\t'"$n"$'\n'
    fi
    tv="_NUT_LKI_TXT_$n"; iv="_NUT_LKI_IDX_$n"
    if [[ -n "${!tv+x}" && "${!tv}" == "$txt" ]]; then
        _nli="${!iv}"
        return 0
    fi
    local name file rest word gates="" idx=$'\n'
    while read -r name file rest || [[ -n "$name" ]]; do
        [[ -z "$name" ]] && continue
        if [[ "${name:0:2}" == "#[" ]]; then
            word="${name#\#\[}"; word="${word%]}"
            gates+="${word} "
            continue
        fi
        [[ "${name:0:1}" == "#" ]] && { gates=""; continue; }
        idx+="${name}"$'\x1f'"${gates}"$'\x1f'"${file}"$'\x1f'"${rest}"$'\n'
        gates=""
    done < "${root}/lib.nut"
    printf -v "$tv" '%s' "$txt"
    printf -v "$iv" '%s' "$idx"
    _nli="$idx"
}

# What a `has(bin(...))` gate answered, so `command -v` runs once per name.
#
# Declared here rather than inside the function: it is an associative array,
# and without the declaration bash reads `_NUT_GATE_ANSWER[has(bin(sh))]` as
# an arithmetic subscript and fails on the parentheses.
# One variable per answer rather than an associative array, keyed by
# `nut_key`. Same trick `deps.sh` has used for its tool tables since it was
# written, and the reason the encoder moved to `lib/key.sh`: a POSIX shell has
# no `declare -A`, and every table here is a map from a string to a string.

# _nut_gate <attribute> -> 0 when it holds
#
# One attribute, in the shape the rest of the library already speaks:
#
#   shell(bash)      the running shell is bash, any version
#   shell(bash4)     bash 4 or newer
#   has(bin(grep))   that command is on PATH
#   has(env(NAME))   that variable is set and not empty
#
# Deliberately four words. A predicate language grows into a parser, and this
# is read before any module is loaded, which is the cycle the manifest format
# exists to avoid.
#
# Written in `case` and `command -v` rather than `[[ =~ ]]`, so it keeps
# working when this file becomes POSIX sh. That is the point of the whole
# arrangement and it would be strange to break it on the first step.
#
# An unknown attribute does not hold. Read as true it would promote a variant
# onto every machine on a typo, and nothing about the tree would look wrong.
_nut_gate() {
    local a="${1:-}" inner name _ng_seen=""
    [[ -n "$a" ]] || return 0

    case "$a" in
        shell\(bash4\))
            case "${BASH_VERSION:-}" in
                ""|1.*|2.*|3.*) return 1 ;;
            esac
            return 0 ;;
        shell\(bash\))
            [[ -n "${BASH_VERSION:-}" ]] || return 1
            return 0 ;;
        has\(bin\(*\)\))
            inner="${a#has(bin(}"; inner="${inner%))}"
            [[ -n "$inner" ]] || return 1
            # What `deps` hides is absent here too, read before the remembered
            # answer since a hide can come after it.
            case " ${NUT_DEPS_HIDE:-} " in *" $inner "*) return 1 ;; esac
            # Remembered, because `command -v` is the only word here that costs
            # anything and this sits in front of every `use`. Not `shell` or
            # `env`: both are a `case` on a variable, which is free, and both
            # can change under a caller.
            nut_key "$a" || return 1
            eval "_ng_seen=\"\${_NUT_GATE_${_nk}:-}\""
            case "$_ng_seen" in
                yes) return 0 ;;
                no)  return 1 ;;
            esac
            if command -v "$inner" >/dev/null 2>&1; then
                eval "_NUT_GATE_${_nk}=yes"; return 0
            fi
            eval "_NUT_GATE_${_nk}=no"; return 1 ;;
        has\(env\(*\)\))
            name="${a#has(env(}"; name="${name%))}"
            # The shape is checked before the indirection, because bash errors
            # on `${!x}` when `x` is not a valid name and that error aborts
            # whoever was loading a module.
            case "$name" in
                ""|*[!A-Za-z0-9_]*|[0-9]*) return 1 ;;
            esac
            # The name reaches `eval`, so the case above is what stands
            # between a manifest and an arbitrary command. `${!name}` did this
            # without one and POSIX has no equivalent.
            eval "_ng_seen=\"\${${name}:-}\""
            [ -n "$_ng_seen" ] || return 1
            return 0 ;;
        feature\(*\))
            name="${a#feature(}"; name="${name%)}"
            case "$name" in
                ''|*[!A-Za-z0-9_-]*) return 1 ;;
            esac
            _nut_feature_on "$name" ;;
        *)
            printf 'nutshell: unknown gate %s\n' "$a" >&2
            return 1 ;;
    esac
}

# Which features are on, worked out once from `nut.toml` and the environment.
#
# Read here rather than through `toml`, because a gate is what `use` consults
# and `use` is what would load `toml`. A dozen lines of `[features]` parsing
# beats a cycle.
#
# The shape is cargo's: a table of names, each a list of other names it turns
# on, and a `default` set that `NUT_NO_DEFAULT_FEATURES` drops. `NUT_FEATURES`
# adds to whatever is left, so the two compose the way `--features` and
# `--no-default-features` do.
_NUT_FEATURES=""
_NUT_FEATURES_READY=0

# Worked out on the first gate that asks, not while this file is sourced.
#
# That laziness is what lets a tool source `init`, parse its own flags, export
# `NUT_FEATURES` and have the export count: nothing has read the set yet. Warm
# it here and every such tool would need to know to forget it again.
_nut_features_load() {
    [ "$_NUT_FEATURES_READY" = "1" ] && return 0
    _NUT_FEATURES_READY=1

    local toml="${_NUTSHELL_ROOT}/nut.toml" line insec=0 seen=0 key rest want
    _NUT_FEATURES=""

    want=""
    if [ "${NUT_NO_DEFAULT_FEATURES:-0}" != "1" ]; then want="default"; fi
    want="${want} ${NUT_FEATURES:-}"

    # Nothing asked for and no defaults wanted: an empty set, which is a real
    # answer rather than a reason to read the file.
    case "$want" in
        ' '|'') return 0 ;;
    esac
    [ -r "$toml" ] || { _NUT_FEATURES=" ${NUT_FEATURES:-} "; return 0; }

    # `<name> = [...]` inside `[features]`, one per line. A feature whose list
    # names others turns those on too, which is the one bit of cargo's model
    # that is not just a set.
    local names="" lists="" n more
    while IFS= read -r line || [ -n "$line" ]; do
        # Leading space is legal TOML. Without this an indented `[features]`
        # was not a table at all, so every feature came back undeclared and
        # every module gated on one silently did not load.
        line="${line#"${line%%[![:space:]]*}"}"
        case "$line" in
            \[features\]*) insec=1; seen=1; continue ;;
            # Stop at the end of the section rather than reading to the end of
            # the file. `[features]` sits at line 51 of 329 here, and walking
            # the remaining 278 in shell was most of what a parse cost.
            \[*\]*) [ "$seen" = "1" ] && break; insec=0; continue ;;
        esac
        [ "$insec" = "1" ] || continue
        case "$line" in ''|'#'*) continue ;; esac
        case "$line" in *=*) ;; *) continue ;; esac
        key="${line%%=*}"; rest="${line#*=}"
        key="${key%"${key##*[![:space:]]}"}"; key="${key#"${key%%[![:space:]]*}"}"
        case "$key" in ''|*[!A-Za-z0-9_-]*) continue ;; esac
        # A value may span lines, which is legal and was being read as an empty
        # list: `default = [` on its own line took everything after the `[`,
        # found nothing, and dropped every entry the list actually named.
        case "$rest" in
            *\[*)
                while :; do
                    case "$rest" in *\]*) break ;; esac
                    IFS= read -r more || break
                    rest="${rest} ${more}"
                done ;;
        esac
        # The list, with the brackets, quotes and commas taken out.
        #
        # Chopped rather than handed to `tr`. The substitution and the pipe and
        # the exec came to 9.2ms per parse, on a file with two rows in it, and
        # this runs on every lookup of a feature-gated module. A commit that
        # measured a full twelve-module load at 363ms was spending 28 of them
        # here. The loop below leaves the process.
        rest="${rest#*\[}"; rest="${rest%%]*}"
        n=""
        while [ -n "$rest" ]; do
            case "$rest" in
                [\"\',]*) rest="${rest#?}"; continue ;;
            esac
            n="${n}${rest%%[\"\',]*}"
            case "$rest" in
                *[\"\',]*) rest="${rest#*[\"\',]}" ;;
                *) rest="" ;;
            esac
        done
        rest="$n"
        names="${names} ${key}"
        lists="${lists}|${key}=${rest}"
    done < "$toml"

    # Walk what was asked for, adding what each one names, until nothing new
    # appears. A feature naming itself, or a cycle, terminates because a name
    # already in the set is not added again.
    local queue="$want" cur added=1
    while [ "$added" = "1" ]; do
        added=0
        for cur in $queue; do
            case " $_NUT_FEATURES " in *" $cur "*) continue ;; esac
            # A name nothing declares is reported, the way `_nut_gate` reports
            # a gate it does not know and for the same reason: a feature that
            # is a typo turns nothing on, and the module gated on the correct
            # spelling is then simply absent with nothing said about it.
            case " $names " in
                *" $cur "*) ;;
                *) printf 'nutshell: unknown feature %s\n' "$cur" >&2 ;;
            esac
            _NUT_FEATURES="${_NUT_FEATURES} ${cur}"
            added=1
            case "$lists" in
                *"|${cur}="*)
                    n="${lists#*|${cur}=}"; n="${n%%|*}"
                    queue="${queue} ${n}" ;;
            esac
        done
    done
    _NUT_FEATURES=" ${_NUT_FEATURES# } "
    return 0
}

#[pub]
# Whether a feature is on.
# Usage: nut_feature_on bash -> returns 0 when enabled
_nut_feature_on() {
    _nut_features_load
    case "$_NUT_FEATURES" in *" ${1} "*) return 0 ;; esac
    return 1
}

#[pub]
# Every feature that is on, one per line. For a tool that has to pass the set
# on to something else.
# Usage: nutshell_features
nutshell_features() {
    _nut_features_load
    local f
    for f in $_NUT_FEATURES; do printf '%s\n' "$f"; done
}

# _lib_nut_modules <root>
#
# Every module a library declares, one per line. For the checker, and for an
# error that can list what was actually available.
_lib_nut_modules() {
    local root="$1" name _rest
    [[ -r "${root}/lib.nut" ]] || return 1
    while read -r name _rest || [[ -n "$name" ]]; do
        [[ -z "$name" || "${name:0:1}" == "#" ]] && continue
        printf '%s\n' "$name"
    done < "${root}/lib.nut"
}

# _use_resolve <mod> [caller-file]
#
# The file a module name points at, without loading it. `use` and `nut_reload`
# both need this answer and had one copy each, which is how they came to
# disagree about which file a name meant.
_use_resolve() {
    _use_resolve_to "$@" || return 1
    printf '%s' "$_NUT_RES"
}

# The same answer, into `_NUT_RES`, without a subshell: `use` asks it for every
# module it loads.
_use_resolve_to() {
    local mod="$1" caller="${2:-}" mod_path=""
    _NUT_RES=""
    # A caller named outright wins. `use` reads the frame that wrote it, which
    # is right when a file wrote it and wrong when nut_reload did: the frame is
    # then init, and a `super::` resolves against nutshell instead of the unit
    # that asked.
    [[ -n "${_NUT_SUPER_FROM:-}" ]] && caller="$_NUT_SUPER_FROM"
    if [[ "$mod" == super::* ]]; then
        local _from
        if [[ -n "$caller" && "$caller" == */* ]]; then
            _nut_caller_dir "$caller"; _from="$_ncd"
        else
            _from="$PWD"
        fi
        _use_super_resolve_to "${mod#super::}" "$_from" || return 1
        mod_path="$_NUT_SR"
    elif [[ "$mod" == *"::"* ]]; then
        _lib_nut_lookup_to "$_NUTSHELL_ROOT" "$mod" 2>/dev/null; mod_path="$_NUT_LK"
        if [[ -z "$mod_path" ]]; then
            use extern || return 1
            # Where the asking file lives, so extern can find that unit's
            # manifest rather than searching from wherever the process happens
            # to have been started.
            local _NUT_ASKING_FROM=""
            if [[ -n "$caller" && "$caller" == */* ]]; then
                _nut_caller_dir "$caller"; _NUT_ASKING_FROM="$_ncd"
            fi
            mod_path="$(extern_resolve "$mod")" || return 1
        fi
    else
        # nutshell's own, through its own declaration. Straight to
        # lib/<name>.sh, a bare `use json/impl/jq` reached an internal file by
        # spelling a path, which is around the declaration and around the bar
        # that says a consumer may not have it.
        if [[ "$mod" == */* ]]; then
            echo "nutshell: '${mod}' separates modules with '/'" >&2
            echo "  use '::' the whole way down: ${mod//\//::}" >&2
            return 1
        fi
        _lib_nut_lookup_to "$_NUTSHELL_ROOT" "$mod" 2>/dev/null; mod_path="$_NUT_LK"
        [[ -n "$mod_path" ]] || mod_path="${_NUTSHELL_ROOT}/lib/${mod}.sh"
    fi
    [[ -n "$mod_path" ]] || return 1
    _NUT_RES="$mod_path"
}

#[pub]
# Load a module even if it is already loaded.
#
# For one shape: a function that is a stub until an implementation replaces it.
# The implementation is chosen at the first call, and if something has since
# put the stub back over the binding, the implementation has to run again to
# make it. `use` will not, by design, and that is right for every other case.
#
# Rare on purpose. If a module needs reloading for any other reason, the thing
# to fix is why it does not survive being loaded once.
# Usage: nut_reload super::text::impl::grep_match
nut_reload() {
    # The unit that wrote this call, carried through the `use` below so a
    # `super::` means what it meant where it was written.
    local _NUT_SUPER_FROM="${BASH_SOURCE[1]:-}"
    local mod
    for mod in "$@"; do
        # Forget the file, and every name that reached it, then load again.
        #
        # By file, not by the name this caller happens to use: a module loaded
        # under one name and reloaded under another would otherwise forget
        # nothing, `use` would answer "already loaded", and the stub that asked
        # for the reload would still be the stub.
        local file=""; _nut_loaded_get LOADED_AS "$mod" && file="$_nl"
        if [[ -z "$file" ]]; then
            local _p=""; _use_resolve_to "$mod" "${BASH_SOURCE[1]:-}" && _p="$_NUT_RES"
            [[ -n "$_p" ]] && { if _nut_realpath_to "$_p"; then file="$_nr"; else file="$_p"; fi; }
        fi
        if [[ -n "$file" ]]; then
            _nut_loaded_unset LOADED "$file"
            local k rest="$_NUT_LOADED_AS_KEYS"
            while [[ -n "$rest" ]]; do
                k="${rest%%$'\n'*}"; rest="${rest#*$'\n'}"
                _nut_loaded_get LOADED_AS "$k" && [[ "$_nl" == "$file" ]] \
                    && _nut_loaded_unset LOADED_AS "$k"
            done
            # nut_once has its own record of the same fact.
            local once="_NUT_ONCE_${file//[^A-Za-z0-9]/_}"
            unset "$once"
        fi
        use "$mod" || return 1
    done
    return 0
}

# nut_lazy_guard <name>
#
# For a function that loads an implementation and then calls the name that
# implementation was supposed to rebind. If it was not rebound, that call is
# the function calling itself, and it does so until the shell runs out of
# stack: no message, no exit status, the process simply disappears.
#
# It used to be safe because `source` re-runs a file every time. `use` loads a
# file once, so the day the implementation is already loaded and the stub is
# somehow back in place, the stub is on its own.
#
# Called at the top of the stub. Returns 1 when the stub is re-entering itself,
# with an error that names the module rather than nothing at all.
nut_lazy_guard() {
    local name="$1" key="_NUT_LAZY_${1//[^A-Za-z0-9]/_}"
    if [[ -n "${!key:-}" ]]; then
        printf '[ERROR] %s: its implementation loaded but did not define %s\n' "$name" "$name" >&2
        printf '        the module was probably re-sourced over a binding it had already made\n' >&2
        return 1
    fi
    return 0
}

# _nut_realpath <path>
#
# One spelling for one file. `use` and `nut_once` are two guards for the same
# property, and they keyed it differently: `use` on a canonicalised path,
# `nut_once` on whatever string `BASH_SOURCE` happened to hold. So a module
# loaded once through the resolver and then sourced again by a relative path
# passed the second guard, ran again, and reinstalled its lazy stubs over
# bindings the implementation had already made.
_nut_realpath() {
    _nut_realpath_to "$1" || return 1
    printf '%s' "$_nr"
}

# The same answer, into `_nr`, without a subshell around the call.
#
# `use` and `nut_once` ask this for every file they load, and the capture
# around the printing form was a fork each time, about a millisecond apiece
# before a module had run a line. The physical directory is remembered for an
# absolute one, so a directory is resolved once per process; a relative one
# depends on where the process stands and is resolved every time.
_NUT_RP_CACHE=""

# _nut_phys_dir <dir> -> `_npd`, the physical form of an absolute directory with
# no `.` or `..` in it; rc 1 where a part of it is a link, which `cd -P` then
# resolves. Each part is a link or it is not, so the physical form of a
# directory is its parent's with its own name on the end, and every directory
# on the way is remembered: the first module in a new directory costs a test
# per part rather than a fork.
_nut_phys_dir() {
    local d="$1" p
    if [[ -z "$d" || "$d" == / ]]; then _npd=/; return 0; fi
    # By a regex where the name allows one, since `${s#*pat}` matches against
    # every prefix of the list in turn.
    local esc="$d" re
    case "$esc" in *[!A-Za-z0-9_./-]*) esc="" ;; esac
    if [[ -n "$esc" ]]; then
        re=$'\n'"${esc//./[.]}"$'\t''([^'$'\n'']*)'
        [[ "$_NUT_RP_CACHE" =~ $re ]] && { _npd="${BASH_REMATCH[1]}"; return 0; }
    elif [[ "$_NUT_RP_CACHE" == *$'\n'"$d"$'\t'* ]]; then
        _npd="${_NUT_RP_CACHE#*$'\n'"$d"$'\t'}"; _npd="${_npd%%$'\n'*}"
        return 0
    fi
    [[ -d "$d" && ! -L "$d" ]] || return 1
    _nut_phys_dir "${d%/*}" || return 1
    p="${_npd%/}/${d##*/}"
    _NUT_RP_CACHE+=$'\n'"$d"$'\t'"$p"$'\n'
    _npd="$p"
}

_nut_realpath_to() {
    local p="$1" d b phys=""
    _nr=""
    [[ -n "$p" ]] || return 1
    d="${p%/*}"; b="${p##*/}"
    [[ "$d" == "$p" ]] && d="."
    # -P, so the key is the physical file. `cd` without it gives the logical
    # path, which leaves a symlinked module and its target as two different
    # keys and therefore two loads of one file.
    case "$d" in
        */./*|*/../*|*/.|*/..|*//*) ;;
        /*) _nut_phys_dir "$d" && phys="$_npd" ;;
    esac
    if [[ -z "$phys" ]]; then
        phys="$(cd -P "$d" 2>/dev/null && pwd)" || phys=""
    fi
    if [[ -n "$phys" ]]; then
        # And the leaf, if that is a link too.
        if [[ -L "${phys}/${b}" ]]; then
            local t; t="$(readlink "${phys}/${b}")"
            case "$t" in
                /*) _nr="$t"; return 0 ;;
                *)  b="$t" ;;
            esac
        fi
        _nr="${phys}/${b}"
        return 0
    fi
    _nr="$p"
}

# _use_mod_fragment <rest>
#
# The path fragment a module path names. `::` separates modules the whole way
# down, so `tui::key` is the `key` module of the `tui` group and reads the same
# as the `shebang::` that got you there.
#
# A `/` is refused rather than translated. It worked for a while, because the
# tail was handed to the filesystem unchanged, and a separator that works by
# accident is one that half the call sites end up using.
_use_mod_fragment() {
    local rest="$1"
    if [[ "$rest" == */* ]]; then
        echo "nutshell: '${rest}' separates modules with '/'" >&2
        echo "  use '::' the whole way down: ${rest//\//::}" >&2
        return 1
    fi
    printf '%s' "${rest//:://}"
}

# _use_super_resolve <rest>
#
# The file `super::<rest>` names, from the unit's own manifest directory. The
# same three shapes `extern_resolve` tries, so a library laid out one way works
# whether it is reached from inside or from a consumer.
#
# Fails loudly rather than falling through to nutshell's own set. A `super::`
# that silently resolved to a nutshell module of the same name would load
# something the author did not write and did not mean.
_use_super_resolve() {
    _use_super_resolve_to "$@" || return 1
    printf '%s' "$_NUT_SR"
}

# The same answer, into `_NUT_SR`, without a subshell around it or inside it.
_use_super_resolve_to() {
    _NUT_SR=""
    local rest="$1" from="$2" root candidate dir
    local declared="$rest"
    if [[ "$rest" == */* ]]; then
        _use_mod_fragment "$rest"; return 1
    fi
    rest="${rest//:://}"

    # Walk up from the file that wrote the `use`, not from the entry point.
    #
    # `_extern_manifest` searches NUTSHELL_SCRIPT_DIR and then PWD, which are
    # both facts about the invocation rather than about the file asking. A
    # module inside a unit, run by an entry script outside it, resolved
    # `super::` against the entry script's unit or against nothing. That is the
    # entry-point anchoring `nut_dir` exists to correct, shipped in the same
    # change that corrects it, which is how a review found it.
    #
    # The caller's own directory is the only anchor that means "this unit" from
    # every file in it.
    dir="$from"
    while [[ -n "$dir" && "$dir" != "/" ]]; do
        if [[ -f "${dir}/nut.toml" ]]; then
            root="$dir"
            break
        fi
        dir="${dir%/*}"
    done

    if [[ -z "${root:-}" ]]; then
        echo "nutshell: 'super::${rest}' needs a nut.toml above ${from}, and none was found" >&2
        echo "  super:: names this unit's own lib/, and the manifest is what marks the unit" >&2
        return 1
    fi
    # What the unit declares, if it declares anything. A library with a lib.nut
    # is answered from it and nowhere else: falling back to a search would put
    # the guessing back under the declaration and hide a wrong entry.
    if [[ -r "${root}/lib.nut" ]]; then
        _lib_nut_lookup_to "$root" "$declared" || {
            echo "nutshell: '${declared}' is not in this unit's lib.nut" >&2
            echo "  it declares: $(_lib_nut_modules "$root" | tr '\n' ' ')" >&2
            return 1
        }
        candidate="$_NUT_LK"
        [[ -f "$candidate" ]] && { _NUT_SR="$candidate"; return 0; }
        echo "nutshell: lib.nut declares '${declared}' at ${candidate#$root/}, which is not there" >&2
        return 1
    fi

    # libs, then lib, then the root. The same order extern uses: the two had
    # one each, `lib` first here and `libs` first there, so a library with both
    # resolved differently depending on who was asking. Only the undeclared
    # path reaches this now, and it exists to be migrated away from.
    for candidate in "${root}/libs/${rest}.sh" "${root}/lib/${rest}.sh" "${root}/${rest}.sh"; do
        [[ -f "$candidate" ]] && { _NUT_SR="$candidate"; return 0; }
    done
    echo "nutshell: this unit has no module '${rest}'" >&2
    echo "  looked in ${root}/lib, ${root}/libs and ${root}" >&2
    return 1
}

# nut_file
#
# The file calling this, absolute. Not the entry script: the file the call is
# written in, the way Deno's `import.meta.filename` and Rust's `file!()` name
# the current source rather than the program.
#
# `NUTSHELL_SCRIPT` is the entry point and is a different question. A module
# that builds a path from that breaks the moment the entry point moves, which
# is a real thing that happened and took a whole test suite down with it.
#
# Usage: nut_file -> prints the calling file, absolute; returns 1 when it cannot be resolved
#[pub]
nut_file() {
    local src="${BASH_SOURCE[1]:-}" dir
    # A source with no slash in it is a relative name resolved against the
    # working directory, which is what `bash s.sh` from the file's own directory
    # produces. The first version stripped `${src%/*}`, got the whole name back,
    # failed to `cd` into it and printed `/s.sh` with exit 0: a wrong absolute
    # path that looks like a right one. Silence is the defect, not the path.
    [[ -z "$src" ]] && { echo "nut_file: no calling file" >&2; return 1; }
    if [[ "$src" == */* ]]; then
        dir="$(cd "${src%/*}" 2>/dev/null && pwd)" || dir=""
    else
        dir="$PWD"
    fi
    [[ -z "$dir" ]] && { echo "nut_file: cannot resolve ${src}" >&2; return 1; }
    printf '%s/%s' "$dir" "${src##*/}"
}
export -f nut_file

# nut_dir
#
# The directory of the file calling this, absolute. What a script wants when it
# reaches for a sibling file, and the answer to the mistake `NUTSHELL_SCRIPT_DIR`
# invites.
#
# Usage: source "$(nut_dir)/helper.sh" -> prints the calling file's directory; returns 1 when it cannot be resolved
#[pub]
nut_dir() {
    local src="${BASH_SOURCE[1]:-}" dir
    [[ -z "$src" ]] && { echo "nut_dir: no calling file" >&2; return 1; }
    if [[ "$src" == */* ]]; then
        dir="$(cd "${src%/*}" 2>/dev/null && pwd)" || dir=""
    else
        dir="$PWD"
    fi
    # Empty with a zero exit was the old behaviour, and it turned the documented
    # `source "$(nut_dir)/helper.sh"` into `source "/helper.sh"`.
    [[ -z "$dir" ]] && { echo "nut_dir: cannot resolve ${src}" >&2; return 1; }
    printf '%s' "$dir"
}
export -f nut_dir

# Export the function so it's available in subshells
export -f use

# =============================================================================
# Introspection utilities
# =============================================================================

# Check if a module is loaded
# Usage: if nutshell_loaded json; then ...
nutshell_loaded() {
    # By name, because that is what a caller has. The name is looked up to a
    # file first, so a module loaded as `super::x` answers yes when asked about
    # `dep::x` too, which is the same module.
    _nut_loaded_get LOADED_AS "$1" && return 0
    _nut_loaded_get LOADED "$1"
}
export -f nutshell_loaded

# List loaded modules
# Usage: nutshell_modules
nutshell_modules() {
    local mod rest="$_NUT_LOADED_KEYS"
    while [[ -n "$rest" ]]; do
        mod="${rest%%$'\n'*}"; rest="${rest#*$'\n'}"
        _nut_loaded_get LOADED "$mod" && printf '%s\n' "$mod"
    done | sort
}
export -f nutshell_modules

# List all available modules
# Usage: nutshell_available
nutshell_available() {
    ls -1 "${_NUTSHELL_ROOT}/lib/"*.sh 2>/dev/null | xargs -n1 basename | sed 's/\.sh$//' | sort
}
export -f nutshell_available

# =============================================================================
# The pins of `[deps.paths]`

# `deps` asks `deps::pins` which path a tool is pinned to, by the names below.
# That file is bash and reads the manifest through toml, and `deps` loads under
# a POSIX shell, so `deps` cannot `use` it. Every script reaches nutshell
# through this file, under bash, so the hand-off is made here: the first pin
# `deps` asks for loads `deps::pins`, which then takes the names over. A
# `deps.sh` sourced bare has neither name, pins nothing, and resolves each tool
# from PATH.
: "${_DEPS_PIN_GET:=_nut_deps_pin_get}"
: "${_DEPS_PIN_CHECK:=_nut_deps_pin_check}"
_nut_deps_pin_get() { use deps::pins || return 1; _deps_pin_get "$@"; }
_nut_deps_pin_check() { use deps::pins || return 0; _deps_pin_check "$@"; }

# `key.sh` was sourced by path above, before `use` existed. Its name is
# recorded now, so a later `use key` is answered from the table rather than
# resolving the name and sourcing the file again to hit its guard. Not as a
# loaded module: it is part of the interpreter, and `nutshell_modules` lists
# what a script asked for.
_nut_loaded_set LOADED_AS key "${_NUTSHELL_ROOT}/lib/key.sh"
